{# Test perflibs (OpenMP and Threads) functionality #}
#include <iostream>

void test_{{PACKAGE_LOWER}}() {
    std::cout << "\n=== Testing {{PACKAGE_NAME}} ===" << std::endl;
    
    // Check compile-time definitions
    std::cout << "Perflibs configuration:" << std::endl;
    
#ifdef HAS_OPENMP
    std::cout << "  HAS_OPENMP: " << HAS_OPENMP << std::endl;
#if HAS_OPENMP
    #include <omp.h>
    std::cout << "  OpenMP available: Yes" << std::endl;
    std::cout << "  Max threads: " << omp_get_max_threads() << std::endl;
#else
    std::cout << "  OpenMP available: No" << std::endl;
#endif
#else
    std::cout << "  HAS_OPENMP: undefined" << std::endl;
#endif

#ifdef HAS_THREADS
    std::cout << "  HAS_THREADS: " << HAS_THREADS << std::endl;
#if HAS_THREADS
    #include <thread>
    std::cout << "  Threads available: Yes" << std::endl;
    std::cout << "  Hardware concurrency: " << std::thread::hardware_concurrency() << std::endl;
#else
    std::cout << "  Threads available: No" << std::endl;
#endif
#else
    std::cout << "  HAS_THREADS: undefined" << std::endl;
#endif
    
    std::cout << "{{PACKAGE_NAME}} test completed successfully!" << std::endl;
}
