// Multi-package test for: {{TEST_NAME}}
// Test ID: {{TEST_ID}}

#include <iostream>
#include <string>

{% set known_packages = ["Eigen3", "Yaml", "logging", "testing", "Clipp", "perflibs",
                          "Spectra", "Ceres", "NetCDF", "NetCDFCXX4", "Csv", "Enum", "Grppi"] %}

{% for package in PACKAGES.keys() %}
{% if package in known_packages %}
{% with PACKAGE_NAME=package, PACKAGE_LOWER=package.lower(), PACKAGE_UPPER=package.upper() %}
{% include "_test_" + package + ".inc.j2" %}
{% endwith %}
{% else %}
// Generic test for {{package}}
void test_{{package.lower()}}() {
    std::cout << "=== Testing {{package}} ===" << std::endl;
    std::cout << "  {{package}} loaded and linked successfully" << std::endl;
    std::cout << "✅ {{package}} test passed!" << std::endl;
}
{% endif %}

{% endfor %}

int main() {
    std::cout << "Testing {{TEST_NAME}}..." << std::endl;
    std::cout << std::endl;

{% for package in PACKAGES.keys() %}
    try {
        test_{{package.lower()}}();
    } catch (const std::exception& e) {
        std::cerr << "{{package}} test failed: " << e.what() << std::endl;
        return 1;
    }
    std::cout << std::endl;
{% endfor %}

    std::cout << "{{TEST_NAME}} completed successfully!" << std::endl;
    return 0;
}
