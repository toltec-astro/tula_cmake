[settings]
os=Linux
arch={{ {"aarch64": "armv8", "x86_64": "x86_64"}.get(platform.machine(), platform.machine()) }}
compiler=clang
compiler.version=20
compiler.libcxx=libstdc++11
compiler.cppstd=23
build_type=Debug

[conf]
tools.build:compiler_executables={"c": "clang-20", "cpp": "clang++-20"}
tools.build:jobs=8
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
CMAKE_POLICY_VERSION_MINIMUM=3.5

[replace_tool_requires]
cmake/*: cmake/3.31.12
