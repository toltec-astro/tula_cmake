# Homebrew LLVM/Clang on macOS

{% set prefix = subprocess.check_output(['brew', '--prefix', 'llvm']).decode().strip() %}
{% set cc = prefix + "/bin/clang" %}
{% set cxx = prefix + "/bin/clang++" %}
{% set compiler, version, _ = detect_api.detect_clang_compiler(cxx) %}

[settings]
os=Macos
arch={{ detect_api.detect_arch() }}
compiler={{ compiler }}
compiler.version={{ detect_api.default_compiler_version(compiler, version) }}
compiler.libcxx={{ detect_api.detect_libcxx(compiler, version, cxx) }}
compiler.cppstd=23

[buildenv]
CC={{ cc }}
CXX={{ cxx }}

[conf]
tools.build:compiler_executables={"c": "{{ cc }}", "cpp": "{{ cxx }}"}
