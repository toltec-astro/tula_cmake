# _deps_callbacks.cmake - Helper functions for dependency target files
#
# Reduces boilerplate in TULA_{PACKAGE}_TRY_* and TULA_{PACKAGE}_CREATE_WRAPPER functions

include_guard(GLOBAL)

#[=======================================================================[
@brief Helper to set success variable and return early if target exists
@param PACKAGE Package name (e.g., Eigen3)
@param UPSTREAM_TARGET Upstream target name (e.g., Eigen3::Eigen)
@param MODE Mode name (CONAN, CPM, SYSTEM)
]=======================================================================]
function(_tula_check_target_exists PACKAGE UPSTREAM_TARGET MODE)
    if(TARGET ${UPSTREAM_TARGET})
        set(TULA_${PACKAGE}_${MODE}_SUCCESS TRUE PARENT_SCOPE)
        set(_TULA_TARGET_EXISTS TRUE PARENT_SCOPE)
    else()
        set(_TULA_TARGET_EXISTS FALSE PARENT_SCOPE)
    endif()
endfunction()

#[=======================================================================[
@brief Standard TRY_CONAN implementation for header-only libraries
@param PACKAGE Package name for variable naming (e.g., Yaml)
@param UPSTREAM_TARGET Upstream target name (e.g., yaml-cpp::yaml-cpp)
@param FIND_NAME (Optional) Name to use in find_package (defaults to PACKAGE)

Uses find_package() to locate the CMake config files generated by CMakeDeps.
Conan's CMakeDeps generator creates the target automatically, so we just verify it exists.

Usage:
    tula_try_conan_header_only(Eigen3 Eigen3::Eigen)
    tula_try_conan_header_only(Yaml yaml-cpp::yaml-cpp yaml-cpp)
]=======================================================================]
function(tula_try_conan_header_only PACKAGE UPSTREAM_TARGET)
    set(FIND_NAME "${PACKAGE}")
    if(ARGC GREATER 2)
        set(FIND_NAME "${ARGV2}")
    endif()
    
    _tula_check_target_exists(${PACKAGE} ${UPSTREAM_TARGET} CONAN)
    if(_TULA_TARGET_EXISTS)
        return()
    endif()
    
    # Try to find the package via generated CMake config files from CMakeDeps
    # Conan's CMakeDeps creates <Package>Config.cmake files that define targets
    find_package(${FIND_NAME} CONFIG QUIET)
    
    if(TARGET ${UPSTREAM_TARGET})
        message(STATUS "    Found ${PACKAGE} via Conan CMakeDeps")
        set(TULA_${PACKAGE}_CONAN_SUCCESS TRUE PARENT_SCOPE)
    else()
        message(STATUS "    ${PACKAGE} not found via Conan CMakeDeps")
        set(TULA_${PACKAGE}_CONAN_SUCCESS FALSE PARENT_SCOPE)
    endif()
endfunction()

#[=======================================================================[
@brief Standard TRY_CPM implementation
@param PACKAGE Package name (e.g., Eigen3)
@param UPSTREAM_TARGET Upstream target name (e.g., Eigen3::Eigen)
@param ... Additional arguments passed to CPMAddPackage

Usage:
    tula_try_cpm(Eigen3 Eigen3::Eigen
        NAME Eigen3
        URL "https://gitlab.com/libeigen/eigen/-/archive/3.4.1/eigen-3.4.1.tar.gz"
        OPTIONS "EIGEN_BUILD_DOC OFF" "BUILD_TESTING OFF"
    )
]=======================================================================]
function(tula_try_cpm PACKAGE UPSTREAM_TARGET)
    _tula_check_target_exists(${PACKAGE} ${UPSTREAM_TARGET} CPM)
    if(_TULA_TARGET_EXISTS)
        return()
    endif()
    
    include(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/_ensure_cpm.cmake)
    
    # Forward remaining arguments to CPMAddPackage
    CPMAddPackage(${ARGN})
    
    # Check if package was added or target exists
    # Some packages use lowercase names (e.g., yaml-cpp creates yaml-cpp, not Yaml)
    if(${PACKAGE}_ADDED OR TARGET ${UPSTREAM_TARGET})
        message(STATUS "    Fetched ${PACKAGE} via CPM")
        set(TULA_${PACKAGE}_CPM_SUCCESS TRUE PARENT_SCOPE)
    else()
        message(STATUS "    CPM fetch failed for ${PACKAGE}")
        set(TULA_${PACKAGE}_CPM_SUCCESS FALSE PARENT_SCOPE)
    endif()
endfunction()

#[=======================================================================[
@brief Standard TRY_SYSTEM implementation
@param PACKAGE Package name (e.g., Eigen3)
@param UPSTREAM_TARGET Upstream target name (e.g., Eigen3::Eigen)
@param FIND_PACKAGE_NAME Optional find_package name (defaults to PACKAGE)
]=======================================================================]
function(tula_try_system PACKAGE UPSTREAM_TARGET)
    set(_optional_args ${ARGN})
    list(LENGTH _optional_args _num_args)
    
    if(_num_args GREATER 0)
        list(GET _optional_args 0 _find_name)
    else()
        set(_find_name ${PACKAGE})
    endif()
    
    _tula_check_target_exists(${PACKAGE} ${UPSTREAM_TARGET} SYSTEM)
    if(_TULA_TARGET_EXISTS)
        return()
    endif()
    
    find_package(${_find_name} CONFIG QUIET)
    
    if(TARGET ${UPSTREAM_TARGET})
        message(STATUS "    Found ${PACKAGE} via system find_package")
        set(TULA_${PACKAGE}_SYSTEM_SUCCESS TRUE PARENT_SCOPE)
    else()
        message(STATUS "    System find_package failed for ${PACKAGE}")
        set(TULA_${PACKAGE}_SYSTEM_SUCCESS FALSE PARENT_SCOPE)
    endif()
endfunction()

#[=======================================================================[
@brief Standard CREATE_WRAPPER implementation for simple cases
@param PACKAGE Package name (e.g., Eigen3)
@param UPSTREAM_TARGET Upstream target to wrap (e.g., Eigen3::Eigen)
@param ... Additional dependencies to link

Usage:
    tula_create_wrapper(Eigen3 Eigen3::Eigen tula::perflibs)
]=======================================================================]
function(tula_create_wrapper PACKAGE UPSTREAM_TARGET)
    set(_tula_target "tula_${PACKAGE}")
    
    if(TARGET ${_tula_target})
        return()  # Already created
    endif()
    
    if(NOT TARGET ${UPSTREAM_TARGET})
        message(FATAL_ERROR "Cannot create wrapper: ${UPSTREAM_TARGET} target does not exist")
    endif()
    
    include(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/make_tula_target.cmake)
    make_tula_target(${PACKAGE} ${UPSTREAM_TARGET} ${ARGN})
endfunction()
