{% set llvm_prefix = subprocess.check_output(["brew", "--prefix", "llvm@20"], text=True).strip() %}
{% set compiler, version, compiler_exe = detect_api.detect_clang_compiler(llvm_prefix + "/bin/clang") %}
{% if version.major != "20" %}
ERROR: macos-brew-llvm-debug requires Homebrew LLVM major 20, detected {{ version }} at {{ llvm_prefix }}
{% endif %}

[settings]
os=Macos
arch={{ detect_api.detect_arch() }}
compiler={{ compiler }}
compiler.version={{ detect_api.default_compiler_version(compiler, version) }}
compiler.libcxx=libc++
compiler.cppstd=23
build_type=Debug

[conf]
tools.build:compiler_executables={"c": "{{ llvm_prefix }}/bin/clang", "cpp": "{{ llvm_prefix }}/bin/clang++"}
tools.build:jobs=8
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
PATH=+(path){{ llvm_prefix }}/bin
CMAKE_POLICY_VERSION_MINIMUM=3.5

[replace_tool_requires]
cmake/*: cmake/3.31.12
