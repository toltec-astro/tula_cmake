{# Enum utilities test (meta_enum + bitmask) #}
#include <meta_enum/meta_enum.hpp>
#include <bitmask/bitmask.hpp>
#include <cassert>

meta_enum(Color, int, Red = 1, Green = 2, Blue = 4);
BITMASK_DEFINE_MAX_ELEMENT(Color, Blue)

void test_enum() {
    std::cout << "=== Testing Enum (meta_enum + bitmask) ===" << std::endl;

    // meta_enum: name lookup using Color_value_to_string() lambda
    // (Color_meta_from_value has a typo in the Jerry-Ma fork: emta_enum instead of meta_enum)
    auto name = Color_value_to_string(Color::Red);
    assert(name == "Red" && "meta_enum should return 'Red'");
    std::cout << "  meta_enum name(Color::Red) = " << name << std::endl;

    // bitmask: bitwise operations
    auto mask = bitmask::bitmask<Color>{Color::Red} | Color::Blue;
    assert((mask & Color::Red) && "Red should be set");
    assert(!(mask & Color::Green) && "Green should not be set");
    std::cout << "  bitmask Red|Blue set, Green not set: OK" << std::endl;

    std::cout << "Enum test passed!" << std::endl;
}
