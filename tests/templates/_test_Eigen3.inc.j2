{# Eigen3 package test #}
#include <Eigen/Dense>
#include <cmath>
#include <cassert>

void test_{{ PACKAGE_LOWER }}() {
    std::cout << "=== Testing Eigen3 ===" << std::endl;
    
    // Check perflibs integration
    std::cout << "Perflibs integration status:" << std::endl;
    #ifdef HAS_OPENMP
        std::cout << "  OpenMP: " << (HAS_OPENMP ? "ENABLED" : "DISABLED") << std::endl;
    #else
        std::cout << "  OpenMP: NOT DEFINED" << std::endl;
    #endif
    
    #ifdef HAS_THREADS
        std::cout << "  Threads: " << (HAS_THREADS ? "ENABLED" : "DISABLED") << std::endl;
    #else
        std::cout << "  Threads: NOT DEFINED" << std::endl;
    #endif
    
    // Check Eigen3 compile definitions
    #ifdef EIGEN_USE_MKL_ALL
        std::cout << "  MKL: ENABLED" << std::endl;
    #else
        std::cout << "  MKL: DISABLED" << std::endl;
    #endif
    
    #ifdef EIGEN_DONT_PARALLELIZE
        std::cout << "  Eigen Parallelization: DISABLED" << std::endl;
    #else
        std::cout << "  Eigen Parallelization: ENABLED (or default)" << std::endl;
    #endif
    
    std::cout << std::endl;
    
    // Basic functionality test with assertions
    std::cout << "Basic matrix operations:" << std::endl;
    
    // Test 1: Matrix creation and access
    Eigen::Matrix2d m;
    m << 1, 2, 3, 4;
    std::cout << "  Matrix created: " << m.rows() << "x" << m.cols() << std::endl;
    assert(m.rows() == 2 && "Matrix should have 2 rows");
    assert(m.cols() == 2 && "Matrix should have 2 columns");
    assert(m(0,0) == 1 && "Element (0,0) should be 1");
    assert(m(0,1) == 2 && "Element (0,1) should be 2");
    assert(m(1,0) == 3 && "Element (1,0) should be 3");
    assert(m(1,1) == 4 && "Element (1,1) should be 4");
    std::cout << "  ✓ Matrix creation and access OK" << std::endl;
    
    // Test 2: Matrix-vector multiplication
    Eigen::Vector2d v(5, 6);
    Eigen::Vector2d result = m * v;
    std::cout << "  Matrix * Vector result: [" << result.transpose() << "]" << std::endl;
    assert(std::abs(result(0) - 17.0) < 1e-10 && "result(0) should be 17");
    assert(std::abs(result(1) - 39.0) < 1e-10 && "result(1) should be 39");
    std::cout << "  ✓ Matrix-vector multiplication OK" << std::endl;
    
    // Test 3: Determinant computation
    double det = m.determinant();
    std::cout << "  Determinant: " << det << std::endl;
    assert(std::abs(det - (-2.0)) < 1e-10 && "Determinant should be -2");
    std::cout << "  ✓ Determinant computation OK" << std::endl;
    
    // Test 4: Matrix inverse
    Eigen::Matrix2d inv = m.inverse();
    Eigen::Matrix2d identity = m * inv;
    std::cout << "  Matrix inverse computed" << std::endl;
    assert(std::abs(identity(0,0) - 1.0) < 1e-10 && "Identity(0,0) should be 1");
    assert(std::abs(identity(1,1) - 1.0) < 1e-10 && "Identity(1,1) should be 1");
    assert(std::abs(identity(0,1)) < 1e-10 && "Identity(0,1) should be 0");
    assert(std::abs(identity(1,0)) < 1e-10 && "Identity(1,0) should be 0");
    std::cout << "  ✓ Matrix inverse OK" << std::endl;
    
    // Test 5: Eigenvalue computation
    Eigen::SelfAdjointEigenSolver<Eigen::Matrix2d> eigensolver(m + m.transpose());
    if (eigensolver.info() == Eigen::Success) {
        Eigen::Vector2d eigenvalues = eigensolver.eigenvalues();
        std::cout << "  Eigenvalues: [" << eigenvalues.transpose() << "]" << std::endl;
        assert(eigensolver.eigenvalues().size() == 2 && "Should compute 2 eigenvalues");
        std::cout << "  ✓ Eigenvalue computation OK" << std::endl;
    } else {
        std::cerr << "  ✗ Eigenvalue computation FAILED" << std::endl;
        throw std::runtime_error("Eigenvalue computation failed");
    }
    
    std::cout << std::endl;
    std::cout << "✅ All Eigen3 tests passed!" << std::endl;
}
