# Homebrew GCC on macOS

{% set prefix = subprocess.check_output(['brew', '--prefix', 'gcc']).decode().strip() %}
{% set gcc_formula_version = subprocess.check_output(['brew', 'list', '--versions', 'gcc']).decode().split()[1].split('.')[0] %}
{% set cc = prefix + "/bin/gcc-" + gcc_formula_version %}
{% set cxx = prefix + "/bin/g++-" + gcc_formula_version %}
{% set compiler, version, _ = detect_api.detect_gcc_compiler(cxx) %}

[settings]
os=Macos
arch={{ detect_api.detect_arch() }}
compiler={{ compiler }}
compiler.version={{ detect_api.default_compiler_version(compiler, version) }}
compiler.libcxx={{ detect_api.detect_libcxx(compiler, version, cxx) }}
compiler.cppstd=23

[buildenv]
CC={{ cc }}
CXX={{ cxx }}

[conf]
tools.build:compiler_executables={"c": "{{ cc }}", "cpp": "{{ cxx }}"}
