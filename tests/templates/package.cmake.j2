cmake_minimum_required(VERSION 4.1)

project(
    test_{{PROJECT_NAME}}
    VERSION 0.1.0
    DESCRIPTION "{{TEST_NAME}}"
    LANGUAGES CXX
)

# tula::tula is provided by the Conan toolchain (TulaConan).
# It bundles tula headers + all dependency targets loaded during the toolchain phase.
# CPM-compiled packages that were deferred (toolchain phase can't enable CXX recursively)
# are retried here after project() has enabled the CXX language.

# Retry any packages that were deferred from the toolchain phase
if(TULA_DEFERRED_PKGS)
    message(STATUS "Retrying deferred packages post-project(): ${TULA_DEFERRED_PKGS}")
    foreach(_deferred_pkg IN LISTS TULA_DEFERRED_PKGS)
        if(NOT TARGET tula::${_deferred_pkg})
            message(STATUS "  Loading deferred: ${_deferred_pkg}")
            tula_deps_add(TULA_DEPS ${_deferred_pkg})
        else()
            list(APPEND TULA_DEPS tula::${_deferred_pkg})
        endif()
    endforeach()
    set(TULA_DEFERRED_PKGS "" CACHE INTERNAL "")
endif()

add_executable(test_{{PROJECT_NAME}} test_main.cpp)
# Link to tula::tula (toolchain deps) plus TULA_DEPS which includes deferred packages
target_link_libraries(test_{{PROJECT_NAME}} PRIVATE tula::tula ${TULA_DEPS})
target_compile_features(test_{{PROJECT_NAME}} PRIVATE cxx_std_23)

message(STATUS "=== Test Configuration ===")
message(STATUS "Test: {{TEST_NAME}}")
message(STATUS "ID: {{TEST_ID}}")
message(STATUS "Packages: {% for p, m in PACKAGES.items() %}{{p}}={{m}} {% endfor %}")
message(STATUS "Build Type: ${CMAKE_BUILD_TYPE}")
message(STATUS "TULA_DEPS: ${TULA_DEPS}")
message(STATUS "========================")
