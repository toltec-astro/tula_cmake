{# Spectra eigenvalue solver test #}
#include <Spectra/SymEigsSolver.h>
#include <Eigen/Dense>
#include <cassert>

void test_spectra() {
    std::cout << "=== Testing Spectra ===" << std::endl;

    // Build a symmetric positive definite matrix
    Eigen::MatrixXd A(4, 4);
    A << 4, 1, 0, 0,
         1, 4, 1, 0,
         0, 1, 4, 1,
         0, 0, 1, 4;

    Spectra::DenseSymMatProd<double> op(A);
    Spectra::SymEigsSolver<Spectra::DenseSymMatProd<double>> eigs(op, 2, 4);
    eigs.init();
    eigs.compute(Spectra::SortRule::LargestAlge);

    assert(eigs.info() == Spectra::CompInfo::Successful && "Eigenvalue computation should succeed");

    Eigen::VectorXd eigenvalues = eigs.eigenvalues();
    std::cout << "  Top-2 eigenvalues: " << eigenvalues.transpose() << std::endl;
    assert(eigenvalues.size() == 2 && "Should compute 2 eigenvalues");
    assert(eigenvalues(0) > 0 && "Eigenvalues should be positive");

    std::cout << "  ✓ Eigenvalue computation OK" << std::endl;
    std::cout << "✅ Spectra test passed!" << std::endl;
}
