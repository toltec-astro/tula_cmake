{
  "modes": [
    "CONAN",
    "CPM",
    "SYSTEM"
  ],
  "conan_requires": [
    "yaml-cpp/0.8.0"
  ],
  "cmake_vars": {
    "CPM_GITHUB_REPO": "jbeder/yaml-cpp",
    "CPM_GIT_TAG": "0.8.0",
    "CPM_OPTIONS": [
      "YAML_CPP_BUILD_TESTS OFF",
      "YAML_CPP_BUILD_TOOLS OFF",
      "YAML_CPP_BUILD_CONTRIB OFF",
      "YAML_CPP_INSTALL ON"
    ]
  }
}