# System GCC 14 on Linux (explicit version for best C++23 support)

{% set cc = "gcc-14" %}
{% set cxx = "g++-14" %}
{% set compiler, version, _ = detect_api.detect_gcc_compiler(cxx) %}

[settings]
os=Linux
arch={{ detect_api.detect_arch() }}
compiler={{ compiler }}
compiler.version={{ detect_api.default_compiler_version(compiler, version) }}
compiler.libcxx={{ detect_api.detect_libcxx(compiler, version, cxx) }}
compiler.cppstd=23

[buildenv]
CC={{ cc }}
CXX={{ cxx }}
